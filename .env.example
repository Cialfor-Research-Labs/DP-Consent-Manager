# Data Principal Consent Manager - Environment Variables Template
# Copy to .env and customize for your deployment environment

# Runtime Environment (development | test | production)
# In production, the server strictly refuses to start if JWT_SECRET_KEY is not set.
ENVIRONMENT=development

# JWT Cryptographic Configuration
# In production, generate a secure random 256-bit key (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Resend Email Integration ────────────────────────────────────────────────────
# Sign up at https://resend.com to get your API key.
# If not set, emails are printed to the server console (development mode).
RESEND_API_KEY=re_YOUR_API_KEY_HERE

# Verified sender email address (must be from a domain verified in Resend).
# For testing without a domain, use: onboarding@resend.dev (can only send to your Resend account email)
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=DPDP Consent Manager

# ── Direct Gmail / SMTP (Alternative: No custom domain needed!) ──────────────────
# If you don't have a custom domain for Resend, you can send directly from your Gmail
# using a free Google App Password (https://myaccount.google.com/apppasswords).
# When set, the system uses SMTP to send to ANY email address directly.
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Public URL of this app (used in the consent invite link sent via email)
# In production, set this to your actual domain (e.g. https://consent.yourcompany.com)
APP_BASE_URL=http://localhost:8000

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Server-to-Server Gmail Webhook Secret (deprecated — kept for backward compatibility)
GMAIL_WEBHOOK_SECRET=your_gmail_webhook_secret_here

# Server Port
PORT=8000
